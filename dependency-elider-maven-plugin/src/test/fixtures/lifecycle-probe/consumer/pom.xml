<?xml version="1.0" encoding="UTF-8"?>
<!-- WHY: Declares controlled direct dependencies and orders test-only MoJos around a later Maven TEST-resolution phase. -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>io.github.spockz.elider.test</groupId>
    <artifactId>lifecycle-probe-consumer</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>
    <properties>
        <lifecycle.mode>baseline</lifecycle.mode>
        <lifecycle.reportDirectory>${project.build.directory}/lifecycle-probe/${lifecycle.mode}</lifecycle.reportDirectory>
        <lifecycle.replacementFile>${project.build.directory}/replacement/keep-library-trimmed.jar</lifecycle.replacementFile>
    </properties>
    <dependencies>
        <dependency>
            <groupId>io.github.spockz.elider.test</groupId>
            <artifactId>drop-library</artifactId>
            <version>1.0.0</version>
        </dependency>
        <dependency>
            <groupId>io.github.spockz.elider.test</groupId>
            <artifactId>keep-library</artifactId>
            <version>1.0.0</version>
        </dependency>
    </dependencies>
    <build>
        <plugins>
            <plugin>
                <groupId>io.github.spockz.elider.test</groupId>
                <artifactId>lifecycle-probe-maven-plugin</artifactId>
                <version>1.0.0</version>
                <executions>
                    <execution>
                        <id>mutate-artifact-views</id>
                        <phase>initialize</phase>
                        <goals><goal>mutate</goal></goals>
                        <configuration>
                            <mode>${lifecycle.mode}</mode>
                            <replacementFile>${lifecycle.replacementFile}</replacementFile>
                        </configuration>
                    </execution>
                    <execution>
                        <id>observe-without-resolution</id>
                        <phase>process-resources</phase>
                        <goals><goal>observe</goal></goals>
                    </execution>
                    <execution>
                        <id>probe-after-resolution</id>
                        <phase>prepare-package</phase>
                        <goals><goal>probe</goal></goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
