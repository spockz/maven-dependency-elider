<?xml version="1.0" encoding="UTF-8"?>
<!-- WHY: Resolves original artifacts, runs the packaged elide goal, then requests TEST artifacts again. -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>io.github.spockz.elider.test</groupId>
    <artifactId>lifecycle-elide-consumer</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>
    <properties>
        <maven.compiler.release>21</maven.compiler.release>
        <lifecycle.mode>elide-before</lifecycle.mode>
        <lifecycle.reportDirectory>${project.build.directory}/lifecycle-elide</lifecycle.reportDirectory>
        <lifecycle.traceFile>${project.basedir}/trace.txt</lifecycle.traceFile>
        <elide.summaryFile>${project.build.directory}/lifecycle-elide-summary.json</elide.summaryFile>
    </properties>
    <dependencies>
        <dependency>
            <groupId>io.github.spockz.elider.test</groupId>
            <artifactId>drop-library</artifactId>
            <version>1.0.0</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.github.spockz.elider.test</groupId>
            <artifactId>keep-library</artifactId>
            <version>1.0.0</version>
            <scope>runtime</scope>
        </dependency>
    </dependencies>
    <build>
        <plugins>
            <plugin>
                <groupId>io.github.spockz.elider.test</groupId>
                <artifactId>lifecycle-probe-maven-plugin</artifactId>
                <version>1.0.0</version>
                <executions>
                    <execution>
                        <id>observe-original-test-resolution</id>
                        <phase>validate</phase>
                        <goals><goal>probe</goal></goals>
                        <configuration><mode>initial</mode></configuration>
                    </execution>
                    <execution>
                        <id>observe-and-remove-known-leaf-after-elide</id>
                        <phase>process-resources</phase>
                        <goals><goal>post-elide-probe</goal></goals>
                    </execution>
                    <execution>
                        <id>observe-after-elider</id>
                        <phase>prepare-package</phase>
                        <goals><goal>probe</goal></goals>
                        <configuration><mode>later</mode></configuration>
                    </execution>
                </executions>
                <configuration>
                    <reportDirectory>${lifecycle.reportDirectory}</reportDirectory>
                </configuration>
            </plugin>
            <plugin>
                <groupId>io.github.spockz</groupId>
                <artifactId>dependency-elider-maven-plugin</artifactId>
                <version>0.1.0-SNAPSHOT</version>
                <executions>
                    <execution>
                        <id>run-elider</id>
                        <phase>initialize</phase>
                        <goals><goal>elide</goal></goals>
                        <configuration>
                            <trimJars>true</trimJars>
                            <sourceRootsComplete>false</sourceRootsComplete>
                            <traceFiles>
                                <traceFile>${lifecycle.traceFile}</traceFile>
                            </traceFiles>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
