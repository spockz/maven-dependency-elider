<?xml version="1.0" encoding="UTF-8"?>
<!-- WHY: Builds the test-only EventSpy that seeds JDK payload data before lifecycle resolution. -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.github.spockz.elider.test</groupId>
        <artifactId>lifecycle-probe-bootstrap</artifactId>
        <version>1.0.0</version>
        <relativePath>../bootstrap/pom.xml</relativePath>
    </parent>
    <groupId>io.github.spockz.elider.test</groupId>
    <artifactId>production-plan-seed-extension</artifactId>
    <version>1.0.0</version>
    <dependencies>
        <dependency>
            <groupId>org.apache.maven</groupId>
            <artifactId>maven-core</artifactId>
            <version>3.9.9</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>javax.inject</groupId>
            <artifactId>javax.inject</artifactId>
            <version>1</version>
            <scope>provided</scope>
        </dependency>
    </dependencies>
    <build>
        <sourceDirectory>${project.basedir}/../../../java/io/github/spockz/elider/test/resolver/seed</sourceDirectory>
        <resources>
            <resource>
                <directory>${project.basedir}/src/main/resources</directory>
            </resource>
        </resources>
    </build>
</project>
