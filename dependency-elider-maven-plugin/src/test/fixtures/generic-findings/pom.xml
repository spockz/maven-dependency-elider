<?xml version="1.0" encoding="UTF-8"?>
<!-- WHY: Supplies the real Maven binding surface for generic finding lifecycle assertions. -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>io.github.spockz.elider.test</groupId>
  <artifactId>generic-findings-consumer</artifactId>
  <version>1.0.0</version>
  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <maven.compiler.proc>none</maven.compiler.proc>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>
  <dependencies>
    <dependency>
      <groupId>io.github.spockz.elider.test</groupId>
      <artifactId>generic-findings-fixture</artifactId>
      <version>1.0.0</version>
    </dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <groupId>io.github.spockz</groupId>
        <artifactId>dependency-elider-maven-plugin</artifactId>
        <version>@PLUGIN_VERSION@</version>
        <configuration>
          <traceFiles>${project.basedir}/trace.txt</traceFiles>
          <trimJars>true</trimJars>
          <productionClassesComplete>true</productionClassesComplete>
          <vulnerabilityMappings>
            @VULNERABILITY_MAPPINGS@
          </vulnerabilityMappings>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
