<?xml version="1.0" encoding="UTF-8"?>
<!-- WHY: SpotBugs does not recognize constructor-frozen JDK collections returned by immutable records. -->
<FindBugsFilter>
  <Match>
    <Bug code="EI" pattern="EI_EXPOSE_REP" />
    <Class name="io.github.spockz.elider.model.ElisionDecision" />
  </Match>
  <!-- WHY: Maven generates HelpMojo during the build and SpotBugs flags its template code. -->
  <Match>
    <Bug code="EI" pattern="EI_EXPOSE_REP" />
    <Class name="io.github.spockz.elider.model.TraceData" />
  </Match>
  <Match>
    <Bug code="EI" pattern="EI_EXPOSE_REP" />
    <Class name="io.github.spockz.elider.model.StructuredSourceClassEvidence" />
  </Match>
  <Match>
    <Bug code="EI" pattern="EI_EXPOSE_REP" />
    <Class name="io.github.spockz.elider.model.HeuristicCandidateEvidence" />
  </Match>
  <Match>
    <Bug code="EI" pattern="EI_EXPOSE_REP" />
    <Class name="io.github.spockz.elider.model.CveAffectedEntryContext" />
  </Match>
  <Match>
    <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2" />
    <Class name="io.github.spockz.elider.model.MultiReleaseClassInventory$Snapshot" />
  </Match>
  <Match>
    <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2" />
    <Class name="~io\.github\.spockz\.elider\.plugin\.ElisionAnalysisModel\$.*" />
  </Match>
  <Match>
    <Bug pattern="EI_EXPOSE_REP" />
    <Class name="io.github.spockz.elider.plugin.TrimResult" />
  </Match>
  <Match>
    <Bug pattern="EI_EXPOSE_REP" />
    <Class name="io.github.spockz.elider.plugin.nativeimage.NativeImageScanContext" />
  </Match>
  <Match>
    <Bug pattern="UI_INHERITANCE_UNSAFE_GETRESOURCE" />
    <Class name="io.github.spockz.dependency_elider_maven_plugin.HelpMojo" />
  </Match>
  <!-- WHY: JMH-generated harness fields are synthetic and trigger analyzer false positives. -->
  <Match>
    <Class name="~io\.github\.spockz\.elider\..*\.jmh_generated\..*" />
  </Match>
  <!-- WHY: Indexed visitor failures must retain their runtime type when reached. -->
  <Match>
    <Bug pattern="THROWS_METHOD_THROWS_RUNTIMEEXCEPTION" />
    <Class name="io.github.spockz.elider.trimmer.PreparedAnalysisState$ClosureTraversal" />
    <Method name="visit" />
  </Match>
  <!-- WHY: Callback and view-switch failures must restore production state, then retain their runtime cause. -->
  <Match>
    <Bug pattern="THROWS_METHOD_THROWS_RUNTIMEEXCEPTION" />
    <Class name="io.github.spockz.elider.plugin.EliderTestViewExecutionListener" />
    <Method name="mojoStarted" />
  </Match>
  <Match>
    <Bug pattern="THROWS_METHOD_THROWS_RUNTIMEEXCEPTION" />
    <Class name="io.github.spockz.elider.plugin.EliderTestViewExecutionListener" />
    <Method name="beginCompilerView" />
  </Match>
</FindBugsFilter>
