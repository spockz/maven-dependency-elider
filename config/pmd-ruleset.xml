<?xml version="1.0" encoding="UTF-8"?>
<!-- WHY: Keeps broad PMD coverage while tuning naming and control-flow rules to Java APIs and the project style. -->
<ruleset name="Maven Dependency Elider"
    xmlns="http://pmd.sourceforge.net/ruleset/2.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://pmd.sourceforge.net/ruleset/2.0.0 https://pmd.github.io/schema/ruleset_2_0_0.xsd">
  <description>Project Java checks with explicit allowances for concise factories and guard clauses.</description>
  <rule ref="category/java/bestpractices.xml" />
  <rule ref="category/java/codestyle.xml">
    <exclude name="OnlyOneReturn" />
    <exclude name="LongVariable" />
    <exclude name="ShortMethodName" />
  </rule>
  <rule ref="category/java/codestyle.xml/LongVariable">
    <properties>
      <property name="minimum" value="40" />
    </properties>
  </rule>
  <rule ref="category/java/codestyle.xml/ShortMethodName">
    <properties>
      <property name="minimum" value="2" />
    </properties>
  </rule>
  <rule ref="category/java/design.xml">
    <exclude name="LoosePackageCoupling" />
  </rule>
  <rule ref="category/java/documentation.xml" />
  <rule ref="category/java/errorprone.xml">
    <exclude name="CloseResource" />
  </rule>
  <rule ref="category/java/errorprone.xml/CloseResource">
    <properties>
      <!-- Keep PMD 7.28 defaults and allow java.lang.Process, which is not AutoCloseable on target JDK 21 but is on JDK 26+. -->
      <property name="allowedResourceTypes" value="java.io.ByteArrayOutputStream,java.io.ByteArrayInputStream,java.io.StringWriter,java.io.CharArrayWriter,java.util.stream.Stream,java.util.stream.IntStream,java.util.stream.LongStream,java.util.stream.DoubleStream,java.lang.Process" />
    </properties>
  </rule>
  <rule ref="category/java/multithreading.xml" />
  <rule ref="category/java/performance.xml" />
  <rule ref="category/java/security.xml" />
  <rule name="AvoidLegacyCollectionAndEnumerationTypes"
        language="java"
        message="Prefer modern Collection/stream/split APIs over legacy Enumeration, StringTokenizer, Vector, Hashtable, or Stack."
        class="net.sourceforge.pmd.lang.rule.xpath.XPathRule">
    <description>Flags declarations and expressions of legacy Enumeration, StringTokenizer, Vector, Hashtable, and Stack types, including var locals.</description>
    <priority>3</priority>
    <properties>
      <property name="xpath">
        <value><![CDATA[
          //VariableId[
            pmd-java:typeIs('java.util.Enumeration')
            or pmd-java:typeIsExactly('java.util.StringTokenizer')
            or pmd-java:typeIsExactly('java.util.Vector')
            or pmd-java:typeIsExactly('java.util.Hashtable')
            or pmd-java:typeIsExactly('java.util.Stack')
          ]
        ]]></value>
      </property>
    </properties>
  </rule>
</ruleset>
