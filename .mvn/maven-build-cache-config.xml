<?xml version="1.0" encoding="UTF-8"?>
<!-- WHY: Tracks shared lint and fixture inputs so cached module builds stay sound. -->
<cache xmlns="http://maven.apache.org/BUILD-CACHE-CONFIG/1.2.0"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="http://maven.apache.org/BUILD-CACHE-CONFIG/1.2.0 https://maven.apache.org/xsd/build-cache-config-1.2.0.xsd">
    <configuration>
        <enabled>true</enabled>
        <hashAlgorithm>SHA-256</hashAlgorithm>
        <attachedOutputs>
            <dirNames>
                <dirName>classes</dirName>
                <dirName>test-classes</dirName>
            </dirNames>
        </attachedOutputs>
    </configuration>
    <input>
        <global>
            <glob>{*.java,*.xml,*.yaml,*.yml,*.json,*.properties,*.txt}</glob>
            <includes>
                <include>src</include>
                <include>../config</include>
                <include>../examples</include>
            </includes>
            <excludes>
                <exclude>target</exclude>
                <exclude>.scratch</exclude>
            </excludes>
        </global>
    </input>
    <executionControl>
        <runAlways>
            <plugins>
                <plugin artifactId="maven-enforcer-plugin"/>
            </plugins>
        </runAlways>
    </executionControl>
</cache>
