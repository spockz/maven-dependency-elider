<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.spockz</groupId>
        <artifactId>maven-dependency-elider</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>examples</artifactId>
    <packaging>pom</packaging>

    <name>Elider Examples &amp; Integration Fixtures</name>
    <description>Reference projects used as empirical integration test fixtures.</description>

    <properties>
        <elide.mode>baseline</elide.mode>
        <elide.skip>true</elide.skip>
        <elider.verifyElision>false</elider.verifyElision>
    </properties>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>enforce-build-and-dependency-invariants</id>
                        <configuration>
                            <rules>
                                <requirePluginVersions>
                                    <unCheckedPluginList>io.github.spockz:dependency-elider-maven-plugin</unCheckedPluginList>
                                </requirePluginVersions>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <configuration>
                        <systemPropertyVariables>
                            <elider.verifyElision>${elider.verifyElision}</elider.verifyElision>
                        </systemPropertyVariables>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-shade-plugin</artifactId>
                    <configuration>
                        <createDependencyReducedPom>false</createDependencyReducedPom>
                        <filters>
                            <filter>
                                <artifact>*:*</artifact>
                                <excludes>
                                    <exclude>META-INF/*.SF</exclude>
                                    <exclude>META-INF/*.DSA</exclude>
                                    <exclude>META-INF/*.RSA</exclude>
                                    <exclude>META-INF/*.EC</exclude>
                                    <exclude>META-INF/SIG-*</exclude>
                                </excludes>
                            </filter>
                        </filters>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>

    <profiles>
        <profile>
            <id>elision</id>
            <activation>
                <property>
                    <name>elide.mode</name>
                    <value>elision</value>
                </property>
            </activation>
            <properties>
                <elide.skip>false</elide.skip>
            </properties>
            <build>
                <pluginManagement>
                    <plugins>
                        <plugin>
                            <groupId>io.github.spockz</groupId>
                            <artifactId>dependency-elider-maven-plugin</artifactId>
                            <version>${project.version}</version>
                            <configuration>
                                <skip>${elide.skip}</skip>
                            </configuration>
                            <executions>
                                <execution>
                                    <goals>
                                        <goal>elide</goal>
                                    </goals>
                                </execution>
                            </executions>
                        </plugin>
                    </plugins>
                </pluginManagement>
            </build>
        </profile>
    </profiles>

    <!-- Intentionally vulnerable CVE fixtures stay outside this default reactor. -->
    <modules>
        <module>example-basic-app</module>
        <module>example-spring-boot-app</module>
    </modules>
</project>
