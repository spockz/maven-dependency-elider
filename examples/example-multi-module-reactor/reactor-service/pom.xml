        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>io.github.spockz</groupId>
                <artifactId>dependency-elider-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
